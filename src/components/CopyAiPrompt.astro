---
import { getAiPrompt } from '../lib/ai-prompts';

interface Props {
  slug?: string;
}

const { slug: propSlug } = Astro.props;
const routeId = Astro.locals.starlightRoute?.id ?? '';
const pathname = Astro.url.pathname.replace(/^\/|\/$/g, '');
const rawSlug = propSlug || routeId || pathname || 'index';
const prompt = getAiPrompt(rawSlug);
const is404 = rawSlug === '404';
---

{!is404 && (
  <div class="ai-prompt-bar not-content" data-ai-prompt={prompt}>
    <div class="ai-prompt-header">
      <div class="ai-prompt-meta">
        <span class="ai-prompt-badge">
          <svg class="ai-sparkle-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            <path d="M5 3v4"/>
            <path d="M19 17v4"/>
            <path d="M3 5h4"/>
            <path d="M17 19h4"/>
          </svg>
          <span class="badge-title">AI Prompt</span>
        </span>
        <span class="ai-prompt-target-pill">Claude &amp; Cursor</span>
        <span class="ai-prompt-preview-snippet" title={prompt}>{prompt}</span>
      </div>

      <div class="ai-prompt-actions">
        <button
          type="button"
          class="ai-toggle-btn"
          aria-expanded="false"
          aria-label="Toggle full AI prompt text"
          title="Toggle prompt preview"
        >
          <span class="toggle-text">Preview</span>
          <svg class="icon-chevron" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>

        <button
          type="button"
          class="ai-copy-btn"
          aria-label="Copy AI prompt to clipboard"
          title="Copy AI prompt to clipboard"
        >
          <svg class="icon-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <svg class="icon-check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span class="copy-text">Copy Prompt</span>
        </button>
      </div>
    </div>

    <div class="ai-prompt-drawer" hidden>
      <div class="drawer-inner">
        <div class="drawer-meta">
          <span class="version-label">authkestra = "0.13"</span>
          <span class="drawer-hint">Paste directly into Claude, Cursor, or Windsurf</span>
        </div>
        <pre class="ai-prompt-pre"><code>{prompt}</code></pre>
      </div>
    </div>
  </div>
)}

<script>
  function initCopyAiPrompt() {
    const bars = document.querySelectorAll('.ai-prompt-bar[data-ai-prompt]');
    bars.forEach((bar) => {
      const copyBtn = bar.querySelector<HTMLButtonElement>('.ai-copy-btn');
      const toggleBtn = bar.querySelector<HTMLButtonElement>('.ai-toggle-btn');
      const drawer = bar.querySelector<HTMLElement>('.ai-prompt-drawer');

      if (toggleBtn && toggleBtn.dataset.bound !== 'true') {
        toggleBtn.dataset.bound = 'true';
        toggleBtn.addEventListener('click', () => {
          if (!drawer) return;
          const isHidden = drawer.hasAttribute('hidden');
          if (isHidden) {
            drawer.removeAttribute('hidden');
            toggleBtn.setAttribute('aria-expanded', 'true');
            toggleBtn.classList.add('expanded');
            const toggleText = toggleBtn.querySelector('.toggle-text');
            if (toggleText) toggleText.textContent = 'Hide';
          } else {
            drawer.setAttribute('hidden', '');
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.classList.remove('expanded');
            const toggleText = toggleBtn.querySelector('.toggle-text');
            if (toggleText) toggleText.textContent = 'Preview';
          }
        });
      }

      if (copyBtn && copyBtn.dataset.bound !== 'true') {
        copyBtn.dataset.bound = 'true';
        copyBtn.addEventListener('click', async () => {
          const textToCopy = bar.getAttribute('data-ai-prompt') || '';
          try {
            await navigator.clipboard.writeText(textToCopy);
            const copyIcon = copyBtn.querySelector<HTMLElement>('.icon-copy');
            const checkIcon = copyBtn.querySelector<HTMLElement>('.icon-check');
            const copyText = copyBtn.querySelector<HTMLElement>('.copy-text');

            if (copyIcon) copyIcon.style.display = 'none';
            if (checkIcon) checkIcon.style.display = 'inline-block';
            if (copyText) copyText.textContent = 'Copied!';
            copyBtn.setAttribute('title', 'Copied to clipboard');
            copyBtn.classList.add('copied');

            setTimeout(() => {
              if (copyIcon) copyIcon.style.display = 'inline-block';
              if (checkIcon) checkIcon.style.display = 'none';
              if (copyText) copyText.textContent = 'Copy Prompt';
              copyBtn.setAttribute('title', 'Copy AI prompt to clipboard');
              copyBtn.classList.remove('copied');
            }, 2000);
          } catch (e) {
            console.error('Failed to copy prompt to clipboard:', e);
          }
        });
      }
    });
  }

  initCopyAiPrompt();
  document.addEventListener('astro:page-load', initCopyAiPrompt);
</script>

<style>
  .ai-prompt-bar {
    margin: 0.75rem 0 1.5rem 0;
    background: hsl(var(--card));
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius, 0.625rem);
    box-shadow: var(--ak-shadow-1);
    overflow: hidden;
    transition: border-color var(--ak-duration-fast, 120ms) ease, box-shadow var(--ak-duration-fast, 120ms) ease;
  }

  .ai-prompt-bar:hover {
    border-color: var(--sl-color-hairline-light);
    box-shadow: var(--ak-shadow-2);
  }

  .ai-prompt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0.5rem 0.4rem 0.75rem;
    min-height: 42px;
  }

  .ai-prompt-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    flex: 1;
  }

  .ai-prompt-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--ak-text-xs, 0.75rem);
    font-weight: 600;
    line-height: 1;
    color: hsl(var(--primary-accent));
    flex-shrink: 0;
  }

  .ai-sparkle-icon {
    color: hsl(var(--primary-accent));
    flex-shrink: 0;
  }

  .badge-title {
    color: hsl(var(--foreground));
  }

  .ai-prompt-target-pill {
    padding: 0.15rem 0.45rem;
    background: hsl(var(--primary-subtle));
    border: 1px solid hsl(var(--primary) / 0.35);
    border-radius: var(--ak-radius-full, 9999px);
    font-size: 0.7rem;
    line-height: 1;
    color: hsl(var(--primary-accent));
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-prompt-preview-snippet {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    opacity: 0.85;
  }

  .ai-prompt-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .ai-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    font-size: var(--ak-text-xs, 0.75rem);
    font-weight: 500;
    line-height: 1;
    color: hsl(var(--muted-foreground));
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--ak-radius-sm, 0.375rem);
    cursor: pointer;
    transition: color var(--ak-duration-fast, 120ms) ease, background-color var(--ak-duration-fast, 120ms) ease;
  }

  .ai-toggle-btn:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--ak-neutral-800));
  }

  .icon-chevron {
    transition: transform var(--ak-duration-fast, 120ms) ease;
  }

  .ai-toggle-btn.expanded .icon-chevron {
    transform: rotate(180deg);
  }

  .ai-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.65rem;
    font-size: var(--ak-text-xs, 0.75rem);
    font-weight: 500;
    line-height: 1;
    color: hsl(var(--foreground));
    background: hsl(var(--ak-neutral-800));
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--ak-radius-sm, 0.375rem);
    cursor: pointer;
    box-shadow: var(--ak-shadow-1);
    transition: all var(--ak-duration-fast, 120ms) ease;
  }

  .ai-copy-btn:hover {
    color: hsl(var(--foreground));
    border-color: var(--sl-color-hairline-light);
    background: hsl(var(--ak-neutral-700));
  }

  .ai-copy-btn.copied {
    color: hsl(var(--ak-green-400));
    border-color: hsl(var(--ak-green-700));
    background: hsl(var(--ak-green-700) / 0.16);
  }

  .ai-prompt-drawer {
    border-top: 1px solid var(--sl-color-hairline);
    background: hsl(var(--background));
    padding: 0.75rem 1rem;
    animation: drawerEnter var(--ak-duration-fast, 120ms) ease-out;
  }

  @keyframes drawerEnter {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .drawer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--ak-text-xs, 0.75rem);
  }

  .version-tag {
    font-family: var(--sl-font-mono);
    color: hsl(var(--primary-accent));
    background: hsl(var(--card));
    border: 1px solid var(--sl-color-hairline);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
  }

  .drawer-hint {
    color: hsl(var(--muted-foreground));
  }

  .ai-prompt-pre {
    margin: 0;
    padding: 0.75rem 1rem;
    background: hsl(var(--card));
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--ak-radius-sm, 0.375rem);
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
    color: hsl(var(--foreground));
    white-space: pre-wrap;
    word-break: break-word;
    user-select: all;
  }

  @media (max-width: 640px) {
    .ai-prompt-preview-snippet,
    .ai-prompt-target-pill {
      display: none;
    }
    .copy-text {
      display: none;
    }
    .ai-copy-btn {
      padding: 0.35rem;
    }
  }
</style>
